# ---- performance / accuracy -------------------------------------------
WORKERS   = 4
CHUNK     = 180.0
DEG       = 12
TOL       = 1e-7                   # max tail coefficient (deg) before a window is split
VAL_TOL   = 1e-6                   # max error (deg) at held-out validation points
MIN_WIN   = 0.05
WINDOW_OVERRIDE = {}
